# Copy to .env and fill in. With no payment credentials, a built-in sandbox simulator is used.
PORT=3000
# Public URL of this server; JazzCash / EasyPaisa redirect the customer back here.
BASE_URL=http://localhost:3000

# JazzCash merchant sandbox (sandbox.jazzcash.com.pk > Merchant Portal > Integration)
JAZZCASH_MODE=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# EasyPaisa (Easypay) merchant sandbox (easypaystg.easypaisa.com.pk merchant portal)
EASYPAISA_MODE=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_API_USERNAME=
EASYPAISA_API_PASSWORD=
EASYPAISA_ACCOUNT_NUM=

# Escrow rules
COMMISSION_RATE=0.10
AUTO_RELEASE_HOURS=72

# Firebase Phone Login (real SMS codes sent by Firebase). Set these two and the app uses Firebase
# for every login/sign-up code; the SMS_* settings and DEMO_OTP below are then not used. See FIREBASE.md.
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=     (optional, defaults to <project id>.firebaseapp.com)
# FIREBASE_APP_ID=          (optional)

# Firebase database (Cloud Firestore): all app data is saved to Firebase. Set ONE of these to the
# service account key you download from Firebase (see FIREBASE.md, part 1):
# FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json     (path to the key file)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}  (the whole file's text, for hosting sites)

# Phone verification codes. With no SMS provider set, the code is always DEMO_OTP and no SMS is sent.
DEMO_OTP=1234
# SMS gateway (JSON POST {to, text, sender} with a Bearer key; adapt sendSms in src/auth.js to your provider)
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER=KaamWala

# Add-on service requests: warn the customer (and flag for admins) when add-ons push the
# booking more than this % over its original price, or past this many rupees in add-ons.
ADDON_WARN_PERCENT=100
ADDON_WARN_AMOUNT=5000
# With the Firebase database on, uploads are also saved in Firestore (collection _files), so a host that wipes
# its disk (like Render free) loses nothing. See DEPLOY.md.
# Where photos/videos and private verification documents (in a private/ subfolder) are stored (default: data/uploads next to the database)
# UPLOAD_DIR=
